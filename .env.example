# 整個系統（後端、Docker）共用的設定：複製為專案根目錄的 .env（不進版控）。
DATABASE_URL=postgres://socrates:socrates@127.0.0.1:5432/socrates

# 前端／API 共用網域的根網址（S-08.1）；也是 CSRF Origin 檢查的對象
APP_BASE_URL=http://localhost:3000
# Google Cloud Console 建立的 OAuth client；redirect URI 預設為 ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 首次登入即成為管理者的信箱，以逗號分隔
ADMIN_EMAILS=
# 本機 http 開發可設為 false；正式環境保持預設（true）
COOKIE_SECURE=false
# 由後端同網域提供前端建置產物（先在 frontend/ 執行 npm run build）；開發時改用 npm run dev 即可
# FRONTEND_DIR=../frontend/dist
# 本機開發自動執行 migration；正式環境改在部署前單獨執行（S-09.3）
RUN_MIGRATIONS=true

# OpenAI（S-03.1）。具體模型尚未決定（S-03.4 評估後定案），必須明確設定
OPENAI_API_KEY=
OPENAI_MODEL=
# 以下為預設值（S-03.3、S-03.5），需要時才設定
# 可改指向 OpenAI 相容的服務（例如本機開發用 OpenRouter 的免費模型：https://openrouter.ai/api/v1）；
# 這只是開發方便，不代表 S-03.1 的正式選型
# OPENAI_BASE_URL=https://api.openai.com/v1
# WRAP_UP_TURN=15
# MAX_TURNS=20
# AI_FIRST_TOKEN_TIMEOUT_SECS=15
# AI_TOTAL_TIMEOUT_SECS=60
