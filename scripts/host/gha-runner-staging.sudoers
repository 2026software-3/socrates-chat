# /etc/sudoers.d/gha-runner-staging（root:root 0440）
# msi_cubi 上 staging 自動部署的 self-hosted runner（gha-runner）只能以 root 執行部署包裝腳本。
# 安裝：先 visudo -cf 檢查，再 install -o root -g root -m 0440 本檔 /etc/sudoers.d/gha-runner-staging。
# 包裝腳本本身會再驗證參數（40 位小寫十六進位），這裡的萬用字元只是第一道篩選。
gha-runner ALL=(root) NOPASSWD: /usr/local/sbin/socrates-staging-deploy [0-9a-f]*
