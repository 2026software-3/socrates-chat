# /etc/sudoers.d/gha-runner-prod（root:root 0440）
# msi_cubi 上正式環境自動部署的 self-hosted runner（gha-runner-prod）只能以 root 執行部署包裝腳本。
# 安裝：先 visudo -cf 檢查，再 install -o root -g root -m 0440 本檔 /etc/sudoers.d/gha-runner-prod。
# 這裡不寫參數（sudoers 不接受參數中的萬用字元，會被 visudo 拒絕）。sudo 因此允許任何參數，
# 所以參數限制完全由包裝腳本負責：只接受一個 40 位小寫十六進位 SHA，且必須是分支的祖先。
# 與 staging 的 gha-runner 是不同的使用者：staging 分支的 workflow 不能呼叫正式環境的部署。
gha-runner-prod ALL=(root) NOPASSWD: /usr/local/sbin/socrates-prod-deploy
