# 複製為 .env（不進版控）。搭配根目錄 docker-compose.yml 使用。
DATABASE_URL=postgres://socrates:socrates@127.0.0.1:5432/socrates

# 前端／API 共用網域的根網址（S-08.1）；也是 CSRF Origin 檢查的對象
APP_BASE_URL=http://localhost:3000
# Google Cloud Console 建立的 OAuth client；redirect URI 預設為 ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 首次登入即成為管理者的信箱，以逗號分隔
ADMIN_EMAILS=
# 本機 http 開發可設為 false；正式環境保持預設（true）
COOKIE_SECURE=false
# 本機開發自動執行 migration；正式環境改在部署前單獨執行（S-09.3）
RUN_MIGRATIONS=true

# OpenAI（S-03.1）。具體模型尚未決定（S-03.4 評估後定案），必須明確設定
OPENAI_API_KEY=
OPENAI_MODEL=
# 以下為預設值（S-03.3、S-03.5），需要時才設定
# OPENAI_BASE_URL=https://api.openai.com/v1
# WRAP_UP_TURN=15
# MAX_TURNS=20
# AI_FIRST_TOKEN_TIMEOUT_SECS=15
# AI_TOTAL_TIMEOUT_SECS=60
