# msi_cubi 瀏覽器測試用的 .env 範本（放在 ~/socrates-intel/.env，不進版控）。機密不寫在這裡：
# CASCADE_LLM_TOKEN 用 `openssl rand -hex 32` 在主機上產生；OpenAI 金鑰放 .apikeylist（一行一把）。
DATABASE_URL=postgres://socrates:socrates@db:5432/socrates
TEST_BASE_URL=https://raymsicubi.tail5fc9fe.ts.net
APP_BASE_URL=https://raymsicubi.tail5fc9fe.ts.net
COOKIE_SECURE=true
RUN_MIGRATIONS=true
# 後端要求這兩個變數存在；測試環境不用 Google 登入，填佔位值（Google 登入按鈕不會成功，改用示範帳號）
GOOGLE_CLIENT_ID=unused-in-test
GOOGLE_CLIENT_SECRET=unused-in-test
ADMIN_EMAILS=intel-test-admin@example.com
OPENAI_MODEL=gpt-5.4-mini
OPENAI_JUDGE_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODELS=gpt-5-mini,gpt-5.4-nano,gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
# 2026-11-16 語音實測首字曾超過 16 秒（high），測試堆疊改 medium；正式 NTNU 仍是 high，沒有動
OPENAI_REASONING_EFFORT=medium
# app 映像 tag（compose.yml 讀取）；含語音診斷日誌的新映像
APP_IMAGE_TAG=intel-test-diag
WRAP_UP_TURN=15
MAX_TURNS=20
AI_FIRST_TOKEN_TIMEOUT_SECS=45
AI_TOTAL_TIMEOUT_SECS=120
